// DAX measures in the NYC Taxi semantic model (all defined on fact_trips).
// Generated by src/build_pbip.py; edit MEASURES there, not this file.

Trips =
SUM ( fact_trips[trip_count] )
// format: #,0

Avg Trips per Day =
DIVIDE ( [Trips], DISTINCTCOUNT ( dim_date[date] ) )
// format: #,0

Trips PM =
CALCULATE ( [Trips], DATEADD ( dim_date[date], -1, MONTH ) )
// format: #,0

Trips MoM % =
DIVIDE ( [Trips] - [Trips PM], [Trips PM] )
// format: +0.0%;-0.0%;0.0%

Gross Revenue =
SUM ( fact_trips[total_amount] )
// format: \$#,0

Driver Earnings =
SUM ( fact_trips[driver_earnings] )
// format: \$#,0

Meter Hours =
SUM ( fact_trips[duration_min] ) / 60
// format: #,0

Earnings per Meter-Hour =
DIVIDE ( [Driver Earnings], [Meter Hours] )
// format: \$#,0.00

Earnings per Trip =
DIVIDE ( [Driver Earnings], [Trips] )
// format: \$#,0.00

Avg Fare =
DIVIDE ( SUM ( fact_trips[fare_amount] ), [Trips] )
// format: \$#,0.00

Avg Distance (mi) =
DIVIDE ( SUM ( fact_trips[distance_mi] ), [Trips] )
// format: 0.00

Avg Speed (mph) =
DIVIDE ( SUM ( fact_trips[distance_mi] ), [Meter Hours] )
// format: 0.0

Earnings vs City % =
VAR CityRate =
    CALCULATE (
        [Earnings per Meter-Hour],
        REMOVEFILTERS ( fact_trips[trip_type], fact_trips[airport_direction], fact_trips[trip_segment] ),
        fact_trips[trip_type] = "City"
    )
RETURN
    DIVIDE ( [Earnings per Meter-Hour], CityRate ) - 1
// format: +0%;-0%;0%

Card Tip % =
DIVIDE ( SUM ( fact_trips[tip_eligible_tips] ), SUM ( fact_trips[tip_eligible_base] ) )
// format: 0.0%

Flex Fare Share =
DIVIDE ( CALCULATE ( [Trips], fact_trips[pricing] = "Flex Fare" ), [Trips] )
// format: 0.0%

Airport Trip Share =
DIVIDE ( CALCULATE ( [Trips], fact_trips[trip_type] <> "City" ), [Trips] )
// format: 0.0%

Is Ranked Zone =
IF ( [Trips] >= 10000 && SELECTEDVALUE ( dim_zone[service_zone] ) <> "N/A", 1, 0 )
// format: 0

Trips (10k+ zones) =
IF ( [Is Ranked Zone] = 1, [Trips] )
// format: #,0

Earnings per Trip (10k+ zones) =
IF ( [Is Ranked Zone] = 1, [Earnings per Trip] )
// format: \$#,0.00

Earnings per Meter-Hour (10k+ zones) =
IF ( [Is Ranked Zone] = 1, [Earnings per Meter-Hour] )
// format: \$#,0.00

Earnings per Meter-Hour (1k+ trips) =
IF ( [Trips] >= 1000, [Earnings per Meter-Hour] )
// format: \$#,0.00

Zone Latitude =
MIN ( dim_zone[latitude] )
// format: 0.0000

Zone Longitude =
MIN ( dim_zone[longitude] )
// format: 0.0000
