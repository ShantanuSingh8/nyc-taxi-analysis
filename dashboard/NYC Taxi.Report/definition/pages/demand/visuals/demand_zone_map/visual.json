{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json",
  "name": "demand_zone_map",
  "position": {
    "x": 16,
    "y": 396,
    "z": 6000,
    "width": 400,
    "height": 312,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_zone"
                    }
                  },
                  "Property": "zone"
                }
              },
              "queryRef": "dim_zone.zone",
              "nativeQueryRef": "zone"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_trips"
                    }
                  },
                  "Property": "Zone Longitude"
                }
              },
              "queryRef": "fact_trips.Zone Longitude",
              "nativeQueryRef": "Zone Longitude"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_trips"
                    }
                  },
                  "Property": "Zone Latitude"
                }
              },
              "queryRef": "fact_trips.Zone Latitude",
              "nativeQueryRef": "Zone Latitude"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_trips"
                    }
                  },
                  "Property": "Trips"
                }
              },
              "queryRef": "fact_trips.Trips",
              "nativeQueryRef": "Trips"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "gridlineShow": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "gridlineShow": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "bubbles": [
        {
          "properties": {
            "bubbleSize": {
              "expr": {
                "Literal": {
                  "Value": "-12D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Pickup map'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Each bubble is a taxi zone, sized by pickups'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
