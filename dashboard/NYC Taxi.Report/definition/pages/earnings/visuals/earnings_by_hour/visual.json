{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.4.0/schema.json",
  "name": "earnings_by_hour",
  "position": {
    "x": 16,
    "y": 84,
    "z": 5000,
    "width": 760,
    "height": 300,
    "tabOrder": 5000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_hour"
                    }
                  },
                  "Property": "hour"
                }
              },
              "queryRef": "dim_hour.hour",
              "nativeQueryRef": "hour",
              "displayName": "Pickup hour"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_trips"
                    }
                  },
                  "Property": "Earnings per Meter-Hour"
                }
              },
              "queryRef": "fact_trips.Earnings per Meter-Hour",
              "nativeQueryRef": "Earnings per Meter-Hour"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "day_type"
                }
              },
              "queryRef": "dim_date.day_type",
              "nativeQueryRef": "day_type"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_trips"
                    }
                  },
                  "Property": "Avg Speed (mph)"
                }
              },
              "queryRef": "fact_trips.Avg Speed (mph)",
              "nativeQueryRef": "Avg Speed (mph)"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "legend": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "showTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "position": {
              "expr": {
                "Literal": {
                  "Value": "'Top'"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Driver earnings per meter-hour, by pickup hour'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Fare + extra + tip per hour with a passenger aboard. Weekday low: ~$72 at 15:00 (8 mph traffic)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
