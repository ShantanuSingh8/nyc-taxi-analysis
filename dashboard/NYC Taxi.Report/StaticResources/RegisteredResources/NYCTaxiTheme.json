{
  "name": "NYC Taxi",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "background": "#ffffff",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#0d366b",
  "center": "#3987e5",
  "minimum": "#f4f8fd",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0b0b0b" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#52514e" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#0b0b0b" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#ffffff" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#e4e3dc" } }, "radius": 10, "width": 1 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0b0b0b" } }, "fontSize": 11, "fontFamily": "Segoe UI Semibold" }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#6b6a65" } }, "fontSize": 9, "fontFamily": "Segoe UI" }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#ecebe6" } }, "labelColor": { "solid": { "color": "#898781" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#898781" } } }],
        "labels": [{ "color": { "solid": { "color": "#52514e" } }, "fontSize": 8 }],
        "legend": [{ "labelColor": { "solid": { "color": "#52514e" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f4f3ef" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#f4f3ef" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
