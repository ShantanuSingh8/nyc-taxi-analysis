	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"year", Int64.Type}, {"month_num", Int64.Type}, {"month_label", type text}, {"weekday_num", Int64.Type}, {"weekday_name", type text}, {"weekday_short", type text}, {"day_type", type text}, {"is_holiday", type logical}, {"holiday_name", type text}}, "en-US")
