table fact_trips
	lineageTag: 6bbc4739-7b4b-5747-a0ff-f5533ce320d5

	measure Trips = SUM ( fact_trips[trip_count] )
		formatString: #,0
		lineageTag: 6f5236a5-3000-5e51-8457-5f780243e9dc

	measure 'Avg Trips per Day' = DIVIDE ( [Trips], DISTINCTCOUNT ( dim_date[date] ) )
		formatString: #,0
		lineageTag: 430081e5-8a58-5eb9-997a-f9fdbf978ea3

	measure 'Trips PM' = CALCULATE ( [Trips], DATEADD ( dim_date[date], -1, MONTH ) )
		formatString: #,0
		lineageTag: 14aaf382-a751-5632-95f4-207337d30532

	measure 'Trips MoM %' = DIVIDE ( [Trips] - [Trips PM], [Trips PM] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 864f54b6-54ff-5880-a08a-1f308b4f08fe

	measure 'Gross Revenue' = SUM ( fact_trips[total_amount] )
		formatString: \$#,0
		lineageTag: ed6eb154-0dde-525e-ab43-a7fb03f2dbed

	measure 'Driver Earnings' = SUM ( fact_trips[driver_earnings] )
		formatString: \$#,0
		lineageTag: 3f537163-8551-5684-bd39-b80fcd823712

	measure 'Meter Hours' = SUM ( fact_trips[duration_min] ) / 60
		formatString: #,0
		lineageTag: 9ee38821-e8fc-5190-8003-6c6cbfbadc68

	measure 'Earnings per Meter-Hour' = DIVIDE ( [Driver Earnings], [Meter Hours] )
		formatString: \$#,0.00
		lineageTag: d2691dbc-6cfb-5279-b126-44ed8309b3be

	measure 'Earnings per Trip' = DIVIDE ( [Driver Earnings], [Trips] )
		formatString: \$#,0.00
		lineageTag: 22d4e4ab-8425-59b7-bc71-fe32e2a9d269

	measure 'Avg Fare' = DIVIDE ( SUM ( fact_trips[fare_amount] ), [Trips] )
		formatString: \$#,0.00
		lineageTag: 06bcb70f-fe5a-5ec8-bba9-621920ee7c15

	measure 'Avg Distance (mi)' = DIVIDE ( SUM ( fact_trips[distance_mi] ), [Trips] )
		formatString: 0.00
		lineageTag: d8025d0c-105b-5913-b947-0e1f29bc0161

	measure 'Avg Speed (mph)' = DIVIDE ( SUM ( fact_trips[distance_mi] ), [Meter Hours] )
		formatString: 0.0
		lineageTag: 35dbb9a2-8df5-56a7-b073-a67a83ca557e

	measure 'Earnings vs City %' =
			VAR CityRate =
			    CALCULATE (
			        [Earnings per Meter-Hour],
			        REMOVEFILTERS ( fact_trips[trip_type], fact_trips[airport_direction], fact_trips[trip_segment] ),
			        fact_trips[trip_type] = "City"
			    )
			RETURN
			    DIVIDE ( [Earnings per Meter-Hour], CityRate ) - 1
		formatString: +0%;-0%;0%
		lineageTag: 296601c4-b63e-51ad-8e88-58d2210b32d7

	measure 'Card Tip %' = DIVIDE ( SUM ( fact_trips[tip_eligible_tips] ), SUM ( fact_trips[tip_eligible_base] ) )
		formatString: 0.0%
		lineageTag: 28b57a54-b81e-5d5d-a125-0e0ee479f08e

	measure 'Flex Fare Share' = DIVIDE ( CALCULATE ( [Trips], fact_trips[pricing] = "Flex Fare" ), [Trips] )
		formatString: 0.0%
		lineageTag: e3a348fa-ad86-59ba-8d12-68eba87ba4d5

	measure 'Airport Trip Share' = DIVIDE ( CALCULATE ( [Trips], fact_trips[trip_type] <> "City" ), [Trips] )
		formatString: 0.0%
		lineageTag: 21f57291-d41f-5cbe-b833-6e318292e3c0

	measure 'Is Ranked Zone' = IF ( [Trips] >= 10000 && SELECTEDVALUE ( dim_zone[service_zone] ) <> "N/A", 1, 0 )
		formatString: 0
		lineageTag: 36f45a09-d902-5b9a-9640-5018a403b78b

	measure 'Trips (10k+ zones)' = IF ( [Is Ranked Zone] = 1, [Trips] )
		formatString: #,0
		lineageTag: 5297f50a-1ca1-5809-b396-2ba900515c93

	measure 'Earnings per Trip (10k+ zones)' = IF ( [Is Ranked Zone] = 1, [Earnings per Trip] )
		formatString: \$#,0.00
		lineageTag: 050fddd0-c885-5538-bfcb-258dcd66dc8c

	measure 'Earnings per Meter-Hour (10k+ zones)' = IF ( [Is Ranked Zone] = 1, [Earnings per Meter-Hour] )
		formatString: \$#,0.00
		lineageTag: 7411b83c-65fe-5da3-83e4-f60331b05887

	measure 'Earnings per Meter-Hour (1k+ trips)' = IF ( [Trips] >= 1000, [Earnings per Meter-Hour] )
		formatString: \$#,0.00
		lineageTag: 8812f9ae-b6e3-50ed-b1e9-6533873d8b4e

	measure 'Zone Latitude' = MIN ( dim_zone[latitude] )
		formatString: 0.0000
		lineageTag: 39a925a4-0f2f-59e1-a522-d29c802f19b8

	measure 'Zone Longitude' = MIN ( dim_zone[longitude] )
		formatString: 0.0000
		lineageTag: 434e9d0b-5dae-57d0-9af8-8814aef30d94

	column pickup_date
		dataType: dateTime
		formatString: yyyy-mm-dd
