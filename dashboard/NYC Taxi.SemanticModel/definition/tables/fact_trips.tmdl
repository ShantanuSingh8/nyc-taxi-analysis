	partition fact_trips = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_trips.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"pickup_date", type date}, {"pickup_hour", Int64.Type}, {"PULocationID", Int64.Type}, {"pricing", type text}, {"payment_label", type text}, {"trip_type", type text}, {"airport_direction", type text}, {"trip_segment", type text}, {"trip_count", Int64.Type}, {"distance_mi", type number}, {"duration_min", type number}, {"fare_amount", type number}, {"extra", type number}, {"tip_amount", type number}, {"tolls_amount", type number}, {"total_amount", type number}, {"driver_earnings", type number}, {"tip_eligible_trips", Int64.Type}, {"tip_eligible_tips", type number}, {"tip_eligible_base", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
