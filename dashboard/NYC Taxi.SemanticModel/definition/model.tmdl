model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "fact_trips", "dim_date", "dim_hour", "dim_zone"]

ref table fact_trips
ref table dim_date
ref table dim_hour
ref table dim_zone
